FROM node:22-alpine AS builder
WORKDIR /app/cli
COPY cli/package.json cli/package-lock.json ./
RUN npm ci
COPY cli/ .
RUN node build.mjs

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/cli/bundle/markdocs-mcp.cjs ./markdocs-mcp.cjs
COPY --from=builder /app/cli/bundle/markdocs.cjs ./markdocs.cjs

LABEL org.opencontainers.image.title="MarkDocs MCP Server"
LABEL org.opencontainers.image.description="MCP server for MarkDocs — collaborative markdown editor"

ENTRYPOINT ["node", "markdocs-mcp.cjs"]
