{
  "name": "markdocs-cli",
  "version": "0.0.2",
  "description": "CLI and MCP server for MarkDocs — collaborative markdown editor",
  "type": "module",
  "bin": {
    "markdocs": "./bundle/markdocs.cjs",
    "markdocs-mcp": "./bundle/markdocs-mcp.cjs"
  },
  "keywords": ["markdocs", "markdown", "cli", "mcp", "collaborative-editing"],
  "author": "Thakur Kharel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thakurkharel/markdocs",
    "directory": "cli"
  },
  "homepage": "https://markdocs.sh",
  "scripts": {
    "build": "tsc",
    "bundle": "node build.mjs",
    "prepare": "node build.mjs",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
