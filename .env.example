# ── Database ──────────────────────────────────────────────────
# Postgres connection string:
DATABASE_URL="postgresql://user:password@host:5432/markdocs"

# If using connection pooling (e.g. PgBouncer), set DIRECT_URL
# to the non-pooled connection for migrations:
# DIRECT_URL="postgresql://user:password@host:5432/markdocs"

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret"

# ── App ───────────────────────────────────────────────────────
# PORT=3001
